{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@jay-ai/core": ["packages/core/src/index.ts"],
      "@jay-ai/core/*": ["packages/core/src/*"],
      "@jay-ai/agent": ["packages/agent/src/index.ts"],
      "@jay-ai/agent/*": ["packages/agent/src/*"],
      "@jay-ai/coding-agent": ["packages/coding-agent/src/index.ts"],
      "@jay-ai/coding-agent/*": ["packages/coding-agent/src/*"]
    }
  },
  "include": ["packages/*/src/**/*"],
  "exclude": ["node_modules", "**/dist/**"]
}
