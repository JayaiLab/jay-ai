{
  "name": "@jay-ai/coding-agent",
  "version": "0.0.3",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    }
  },
  "bin": {
    "jayai": "./dist/cli.js"
  },
  "scripts": {
    "build": "node esbuild.mjs && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jay-ai/agent": "*",
    "@jay-ai/core": "*",
    "@jay-ai/tui": "*",
    "@sinclair/typebox": "^0.34.48",
    "commander": "^14.0.3",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
