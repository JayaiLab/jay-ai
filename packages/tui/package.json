{
  "name": "@jay-ai/tui",
  "version": "0.0.3",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jay-ai/agent": "*",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "string-width": "^8.2.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
